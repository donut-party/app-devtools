;; shadow-cljs configuration
{:deps           {:aliases [:cljs :dev :framework-dev :monolith]}
 :dev-http       {3100 {:roots     ["resources/public/donut/devtools" "frontend-target/dev/public"]
                        :proxy-url "http://localhost:3110"}}

 :builds {:dev
          {:target           :browser
           :output-dir       "frontend-target/dev/public/js"
           :asset-path       "/js"
           :compiler-options {:optimizations           :none
                              :source-map              true
                              :source-map-detail-level :all
                              :closure-defines         {"re_frame.trace.trace_enabled_QMARK_" true}
                              ;; this is specifically for the warning in loom/alg_generic:494.
                              :warnings                {:invalid-arithmetic false}
                              :cache-blockers          #{donut.compiler.monolith.inject}}

           :modules
           {:main {:entries [donut.devtools.frontend.core]
                   :init-fn donut.devtools.frontend.core/init}}

           ;; start a development http server on http://localhost:3000
           :devtools
           {:preloads    [day8.re-frame-10x.preload]
            :http-root   "frontend-target/dev/public"
            :before-load donut.devtools.frontend.core/stop
            :after-load  donut.devtools.frontend.core/start}

           :tailwind/output
           "resources/donut/devtools/public/css/site.css"

           :tailwind/config
           {:content ["frontend-target/dev/public/**/*.js"
                      "resources/donut/devtools/public/**/*.html"]
            :theme
            {:font-family
             {:mono ["Source Code Pro"
                     "ui-monospace"
                     "SFMono-Regular"
                     "Menlo"
                     "Monaco"
                     "Consolas"
                     "Liberation Mono"
                     "Courier New"
                     "monospace"]}}}}}}
